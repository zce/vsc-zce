{
  "name": "zce",
  "icon": "icon.png",
  "displayName": "zce",
  "publisher": "zce",
  "description": "zce's personal commands",
  "version": "0.0.9",
  "repository": "zce/vsc-zce",
  "license": "MIT",
  "author": "zce <w@zce.me> (https://zce.me)",
  "engines": {
    "vscode": "^1.105.0"
  },
  "enabledApiProposals": [
    "contribCommentsViewThreadMenus"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "ZCE Review",
      "properties": {
        "zce.review.storagePath": {
          "type": "string",
          "default": ".vscode/zce-review.json",
          "markdownDescription": "Path to the review comments JSON file. Relative paths are resolved from the workspace folder root."
        }
      }
    },
    "commands": [
      {
        "command": "zce.copyLocation",
        "title": "Copy Location",
        "category": "ZCE"
      },
      {
        "command": "zce.dotnet.restore",
        "title": "dotnet restore",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.dotnet.build",
        "title": "dotnet build",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.dotnet.clean",
        "title": "dotnet clean",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.dotnet.test",
        "title": "dotnet test",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.review.add",
        "title": "Add Comment",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyAsMarkdown",
        "title": "Copy All",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyUnresolvedAsMarkdown",
        "title": "Copy Unresolved",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyFileAsMarkdown",
        "title": "Copy File",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyFileUnresolvedAsMarkdown",
        "title": "Copy Unresolved in File",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.deleteFileComments",
        "title": "Delete All in File",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.deleteResolvedFileComments",
        "title": "Delete Resolved in File",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.deleteAllResolvedComments",
        "title": "Delete Resolved",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.resolveFileComments",
        "title": "Resolve All in File",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.refresh",
        "title": "Refresh",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.submit",
        "title": "Add Comment",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.editComment",
        "title": "Edit",
        "category": "ZCE Review",
        "icon": "$(edit)"
      },
      {
        "command": "zce.review.saveComment",
        "title": "Save",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.cancelEdit",
        "title": "Cancel",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyThreadAsMarkdown",
        "title": "Copy",
        "category": "ZCE Review",
        "icon": "$(copy)"
      },
      {
        "command": "zce.review.resolveThread",
        "title": "Resolve",
        "category": "ZCE Review",
        "icon": "$(check)"
      },
      {
        "command": "zce.review.unresolveThread",
        "title": "Unresolve",
        "category": "ZCE Review",
        "icon": "$(issues)"
      },
      {
        "command": "zce.review.deleteThread",
        "title": "Delete",
        "category": "ZCE Review",
        "icon": "$(trash)"
      }
    ],
    "submenus": [
      {
        "id": "zce.submenu.review",
        "label": "ZCE Review"
      },
      {
        "id": "zce.submenu.dotnet",
        "label": "ZCE .NET"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zce.copyLocation",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@100"
        },
        {
          "submenu": "zce.submenu.review",
          "when": "editorTextFocus",
          "group": "2_zce@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "zce.submenu.dotnet",
          "when": "explorerResourceIsFolder",
          "group": "navigation@100"
        },
        {
          "submenu": "zce.submenu.review",
          "when": "explorerResourceIsFile",
          "group": "zce@1"
        }
      ],
      "zce.submenu.review": [
        {
          "command": "zce.review.add",
          "when": "editorTextFocus",
          "group": "1_comment@1"
        },
        {
          "command": "zce.review.copyAsMarkdown",
          "when": "editorTextFocus",
          "group": "3_copy@1"
        },
        {
          "command": "zce.review.copyUnresolvedAsMarkdown",
          "when": "editorTextFocus",
          "group": "3_copy@2"
        },
        {
          "command": "zce.review.copyFileAsMarkdown",
          "group": "3_copy@3"
        },
        {
          "command": "zce.review.copyFileUnresolvedAsMarkdown",
          "group": "3_copy@4"
        },
        {
          "command": "zce.review.deleteFileComments",
          "group": "4_delete@1"
        },
        {
          "command": "zce.review.deleteResolvedFileComments",
          "group": "4_delete@2"
        },
        {
          "command": "zce.review.deleteAllResolvedComments",
          "group": "4_delete@3"
        },
        {
          "command": "zce.review.resolveFileComments",
          "group": "8_resolve@1"
        },
        {
          "command": "zce.review.refresh",
          "when": "editorTextFocus",
          "group": "9_refresh@1"
        }
      ],
      "zce.submenu.dotnet": [
        {
          "command": "zce.dotnet.restore",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "zce.dotnet.build",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "zce.dotnet.clean",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "zce.dotnet.test",
          "when": "explorerResourceIsFolder"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "zce.review.copyThreadAsMarkdown",
          "group": "navigation@1",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        },
        {
          "command": "zce.review.resolveThread",
          "group": "navigation@2",
          "when": "commentController == zce.review && commentThread == open"
        },
        {
          "command": "zce.review.unresolveThread",
          "group": "navigation@2",
          "when": "commentController == zce.review && commentThread == resolved"
        },
        {
          "command": "zce.review.deleteThread",
          "group": "navigation@3",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        }
      ],
      "commentsView/commentThread/context": [
        {
          "command": "zce.review.copyThreadAsMarkdown",
          "group": "context@1",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        },
        {
          "command": "zce.review.resolveThread",
          "group": "context@2",
          "when": "commentController == zce.review && commentThread == open"
        },
        {
          "command": "zce.review.unresolveThread",
          "group": "context@2",
          "when": "commentController == zce.review && commentThread == resolved"
        },
        {
          "command": "zce.review.deleteThread",
          "group": "context@3",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        },
        {
          "command": "zce.review.copyThreadAsMarkdown",
          "group": "inline@1",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        },
        {
          "command": "zce.review.resolveThread",
          "group": "inline@2",
          "when": "commentController == zce.review && commentThread == open"
        },
        {
          "command": "zce.review.unresolveThread",
          "group": "inline@2",
          "when": "commentController == zce.review && commentThread == resolved"
        },
        {
          "command": "zce.review.deleteThread",
          "group": "inline@3",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "zce.review.submit",
          "group": "inline",
          "when": "commentController == zce.review && commentThreadIsEmpty"
        },
        {
          "command": "zce.review.submit",
          "group": "inline",
          "when": "commentController == zce.review && !commentThreadIsEmpty && commentThread == open"
        }
      ],
      "comments/comment/title": [
        {
          "command": "zce.review.editComment",
          "group": "overflow@1",
          "when": "commentController == zce.review && (comment == root || comment == userReply) && commentThread == open"
        }
      ],
      "comments/comment/context": [
        {
          "command": "zce.review.saveComment",
          "group": "inline@1",
          "when": "commentController == zce.review"
        },
        {
          "command": "zce.review.cancelEdit",
          "group": "inline@2",
          "when": "commentController == zce.review"
        }
      ],
      "commandPalette": [
        {
          "command": "zce.review.submit",
          "when": "false"
        },
        {
          "command": "zce.review.editComment",
          "when": "false"
        },
        {
          "command": "zce.review.saveComment",
          "when": "false"
        },
        {
          "command": "zce.review.cancelEdit",
          "when": "false"
        },
        {
          "command": "zce.review.copyThreadAsMarkdown",
          "when": "false"
        },
        {
          "command": "zce.review.resolveThread",
          "when": "false"
        },
        {
          "command": "zce.review.unresolveThread",
          "when": "false"
        },
        {
          "command": "zce.review.deleteThread",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zce.copyLocation",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "deploy": "vsce publish --no-yarn --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~25.5.2",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
