{
  "name": "zce",
  "icon": "icon.png",
  "displayName": "zce",
  "publisher": "zce",
  "description": "zce's personal commands",
  "version": "0.0.4",
  "repository": "zce/vsc-zce",
  "license": "MIT",
  "author": "zce <w@zce.me> (https://zce.me)",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "ZCE Review",
      "properties": {
        "zce.review.storagePath": {
          "type": "string",
          "default": ".vscode/ai-review.json",
          "markdownDescription": "Path to the review notes JSON file. Relative paths are resolved from the workspace folder root."
        }
      }
    },
    "commands": [
      {
        "command": "zce.copyLocation",
        "title": "Copy Location",
        "category": "ZCE"
      },
      {
        "command": "zce.dotnet.restore",
        "title": "dotnet restore",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.dotnet.build",
        "title": "dotnet build",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.dotnet.clean",
        "title": "dotnet clean",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.dotnet.test",
        "title": "dotnet test",
        "category": "ZCE .NET"
      },
      {
        "command": "zce.review.add",
        "title": "Add Note",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyAsMarkdown",
        "title": "Copy All as Markdown",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyFileAsMarkdown",
        "title": "Copy File as Markdown",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.submit",
        "title": "Add Note",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.editComment",
        "title": "Edit Note",
        "category": "ZCE Review",
        "icon": "$(edit)"
      },
      {
        "command": "zce.review.saveComment",
        "title": "Save Note",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.cancelEdit",
        "title": "Cancel Edit",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.copyThreadAsMarkdown",
        "title": "Copy as Markdown",
        "category": "ZCE Review",
        "icon": "$(copy)"
      },
      {
        "command": "zce.review.resolveThread",
        "title": "Resolve",
        "category": "ZCE Review",
        "icon": "$(check)"
      },
      {
        "command": "zce.review.unresolveThread",
        "title": "Unresolve",
        "category": "ZCE Review",
        "icon": "$(issues)"
      },
      {
        "command": "zce.review.deleteThread",
        "title": "Delete",
        "category": "ZCE Review",
        "icon": "$(trash)"
      },
      {
        "command": "zce.review.resolveFileNotes",
        "title": "Resolve All Notes in File",
        "category": "ZCE Review"
      },
      {
        "command": "zce.review.deleteFileNotes",
        "title": "Delete All Notes in File",
        "category": "ZCE Review"
      }
    ],
    "submenus": [
      {
        "id": "zce.submenu.dotnet",
        "label": "ZCE .NET"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zce.copyLocation",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@100"
        },
        {
          "command": "zce.review.add",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@101"
        },
        {
          "command": "zce.review.copyFileAsMarkdown",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@102"
        },
        {
          "command": "zce.review.resolveFileNotes",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@103"
        },
        {
          "command": "zce.review.deleteFileNotes",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@104"
        }
      ],
      "explorer/context": [
        {
          "submenu": "zce.submenu.dotnet",
          "when": "explorerResourceIsFolder",
          "group": "navigation@100"
        },
        {
          "command": "zce.review.copyFileAsMarkdown",
          "when": "explorerResourceIsFile",
          "group": "9_cutcopypaste@100"
        },
        {
          "command": "zce.review.resolveFileNotes",
          "when": "explorerResourceIsFile",
          "group": "9_cutcopypaste@101"
        },
        {
          "command": "zce.review.deleteFileNotes",
          "when": "explorerResourceIsFile",
          "group": "9_cutcopypaste@102"
        }
      ],
      "zce.submenu.dotnet": [
        {
          "command": "zce.dotnet.restore",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "zce.dotnet.build",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "zce.dotnet.clean",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "zce.dotnet.test",
          "when": "explorerResourceIsFolder"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "zce.review.copyThreadAsMarkdown",
          "group": "navigation@1",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        },
        {
          "command": "zce.review.resolveThread",
          "group": "navigation@2",
          "when": "commentController == zce.review && commentThread == open"
        },
        {
          "command": "zce.review.unresolveThread",
          "group": "navigation@2",
          "when": "commentController == zce.review && commentThread == resolved"
        },
        {
          "command": "zce.review.deleteThread",
          "group": "navigation@3",
          "when": "commentController == zce.review && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "zce.review.submit",
          "group": "inline",
          "when": "commentController == zce.review && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "zce.review.editComment",
          "group": "group@1",
          "when": "commentController == zce.review && commentThread == open"
        }
      ],
      "comments/comment/context": [
        {
          "command": "zce.review.cancelEdit",
          "group": "inline@1",
          "when": "commentController == zce.review"
        },
        {
          "command": "zce.review.saveComment",
          "group": "inline@2",
          "when": "commentController == zce.review"
        }
      ],
      "commandPalette": [
        {
          "command": "zce.review.submit",
          "when": "false"
        },
        {
          "command": "zce.review.editComment",
          "when": "false"
        },
        {
          "command": "zce.review.saveComment",
          "when": "false"
        },
        {
          "command": "zce.review.cancelEdit",
          "when": "false"
        },
        {
          "command": "zce.review.copyThreadAsMarkdown",
          "when": "false"
        },
        {
          "command": "zce.review.resolveThread",
          "when": "false"
        },
        {
          "command": "zce.review.unresolveThread",
          "when": "false"
        },
        {
          "command": "zce.review.deleteThread",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zce.copyLocation",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~25.5.2",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
